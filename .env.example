# From https://developer.spotify.com/dashboard -> your app -> Settings
SPOTIFY_CLIENT_ID=

# Must match a Redirect URI registered on your Spotify app exactly.
# Spotify requires a loopback IP (127.0.0.1), not "localhost".
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# How often `npm start` checks your recent plays and applies your rules.
SYNC_MINUTES=15
APPLY_MINUTES=60

# Optional overrides
# PLAYPILOT_DB=data/playpilot.db
# PLAYPILOT_RULES=rules.json
